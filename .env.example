# Copy this file to .env and fill in only what you need. .env is git-ignored:
# never commit it, and never paste its content into an issue.

# The shop. Leave both empty for the local shop on http://localhost:9090.
# For the shared workshop instance, set both (see SETUP.md, "The shared instance").
SHOP_URL=
SHOP_SPACE=

# Healing (Module 8), only if your workshop uses an LLM for healing
# (see SETUP.md, "Healing API key").
# HEAL_MODEL=
# HEAL_BASE_URL=
# HEAL_API_KEY=
