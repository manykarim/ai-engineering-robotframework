# Local settings and secrets: API keys, deployment tokens. Never commit.
.env

# The project environment (uv sync --locked); the browsers live inside it.
.venv/
__pycache__/
*.pyc

# Robot Framework output: robot.toml writes to results/, which also holds the
# healing reports (results/heal/) and Browser Library's traces.
results/
output.xml
log.html
report.html
playwright-log.txt
browser/

# Documentation site (ci-and-site): dependencies, build output and cache.
node_modules/
website/build/
website/.docusaurus/

# The Robot Framework MCP server's working files (Lab 6).
.robotmcp_artifacts/
