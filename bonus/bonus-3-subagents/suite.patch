diff --git a/resources/catalogue.resource b/resources/catalogue.resource
index 0b9bc0b..924acf4 100644
--- a/resources/catalogue.resource
+++ b/resources/catalogue.resource
@@ -38,11 +38,21 @@ Get Grid Card Names
     @{names}=    Get Texts    ${GRID} >> article >> role=heading[level=3]
     RETURN    ${names}
 
+Get Grid Card Prices
+    [Documentation]    The price every grid card shows, by its visible text, in page order.
+    @{prices}=    Get Texts    ${GRID} >> article >> ${CARD PRICE}
+    RETURN    ${prices}
+
+Get Grid Card Elements
+    [Documentation]    The product cards of the grid, as elements, in page order.
+    @{cards}=    Get Elements    ${GRID} >> article
+    RETURN    ${cards}
+
 Get Texts
     [Documentation]    The visible text of every element the locator matches.
     [Arguments]    ${locator}
     @{elements}=    Get Elements    ${locator}
-    @{texts}=    Create List
+    VAR    @{texts}=    @{EMPTY}
     FOR    ${element}    IN    @{elements}
         ${text}=    Get Text    ${element}
         Append To List    ${texts}    ${text.strip()}
@@ -88,7 +98,7 @@ Get Price Range Values
 Get Highlight Prices
     [Documentation]    The prices shown in "Handpicked highlights", in page order.
     @{links}=    Get Texts    ${HIGHLIGHTS} >> role=link
-    @{prices}=    Create List
+    VAR    @{prices}=    @{EMPTY}
     FOR    ${text}    IN    @{links}
         ${price}=    Get Regexp Matches    ${text}    \\$[0-9,]+\\.[0-9]{2}
         Append To List    ${prices}    ${price}[0]
diff --git a/resources/checkout.resource b/resources/checkout.resource
index bc2d44c..e0a88ae 100644
--- a/resources/checkout.resource
+++ b/resources/checkout.resource
@@ -50,6 +50,13 @@ Get Summary Amount
     ${amount}=    Amount From Text    ${text}
     RETURN    ${amount}
 
+Get Summary Total
+    [Documentation]    The order total the order summary shows, as a number: the amount beside the
+    ...                label whose visible text has the word "Total" ("Subtotal" does not count).
+    ${text}=    Get Text    ${SUMMARY} >> text=/\\btotal\\b/i >> xpath=..
+    ${total}=    Amount From Text    ${text}
+    RETURN    ${total}
+
 Amount From Text
     [Documentation]    The amount in a text, ``$1,234.50`` as the number 1234.5.
     ...                A label around it is ignored; with several amounts, the last one counts.
@@ -73,11 +80,11 @@ Get New Field Message
     ...                appeared because of the last action, not help text that was already there.
     [Arguments]    ${label}    ${before}
     &{now}=    Get Field Messages    ${label}
-    @{texts}=    Create List
+    VAR    @{texts}=    @{EMPTY}
     FOR    ${id}    ${text}    IN    &{now}
         IF    $id not in $before    Append To List    ${texts}    ${text}
     END
-    ${message}=    Catenate    @{texts}
+    VAR    ${message}=    @{texts}    separator=${SPACE}
     RETURN    ${message}
 
