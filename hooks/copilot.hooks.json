{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "^(create|edit)$",
        "bash": "uv run --no-sync python hooks/no_inline_locators.py",
        "powershell": "uv run --no-sync python hooks/no_inline_locators.py"
      },
      {
        "type": "command",
        "matcher": "^(bash|powershell)$",
        "bash": "uv run --no-sync python hooks/green_before_commit.py",
        "powershell": "uv run --no-sync python hooks/green_before_commit.py"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "^(create|edit)$",
        "bash": "uv run --no-sync python hooks/run_affected_tests.py",
        "powershell": "uv run --no-sync python hooks/run_affected_tests.py",
        "timeoutSec": 300
      }
    ]
  }
}
